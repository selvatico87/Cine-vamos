rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidFavoriteMovie(data, userId) {
      return data.keys().hasAll(['userId', 'movieId', 'title', 'imgURL', 'createdAt'])
        && data.keys().hasOnly(['userId', 'movieId', 'title', 'imgURL', 'createdAt'])
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId == userId && data.userId == request.auth.uid
        && data.movieId is int && data.movieId > 0
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.imgURL is string && data.imgURL.size() >= 1 && data.imgURL.size() <= 512
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId);
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);
      allow delete: if false;

      match /favorites/{movieId} {
        allow get: if isValidId(userId) && isValidId(movieId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(movieId)
          && isOwner(userId)
          && isValidFavoriteMovie(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(movieId)
          && isOwner(userId)
          && isValidFavoriteMovie(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().movieId == existing().movieId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'imgURL']);
        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(movieId)
          && isOwner(userId);
      }
    }
  }
}
